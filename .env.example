# Bu dosya örnek: değerler gizli değil. Kendi değerlerini .env.local dosyasına yaz (git'e girmez).
# Vercel'de aynı anahtarları Project Settings -> Environment Variables'a gir.

# Tarayıcıya giden tek iki değer
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Sadece sunucu (NEXT_PUBLIC_ öneki ASLA eklenmez)
SUPABASE_SECRET_KEY=sb_secret_...
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# İsteğe bağlı: GitHub saatlik istek sınırını 60'tan 5000'e çıkarır (izinsiz, sadece herkese açık okuma)
GITHUB_TOKEN=

# Sitenin adresi (e-postadaki linkler bununla kurulur)
SITE_URL=http://localhost:3000

# Demo hesabı: node scripts/seed.mts üretir
DEMO_EMAIL=
DEMO_PASSWORD=

# Supabase panelinde Google sağlayıcısı açılınca 1 yap
NEXT_PUBLIC_GOOGLE_LOGIN=0

# Günlük otomatik iş (Vercel Cron bunu Authorization başlığında kendisi gönderir). Rastgele, en az 32 karakter.
CRON_SECRET=

# Proje analizi: GITHUB_TOKEN proje başına ~10 istek attığı için canlıda ŞART (izinsiz fine-grained token, sadece herkese açık okuma).

# Yarışma değerlendirmesi: gizli testlerin durduğu ÖZEL GitHub reposu (ör. Omersabri16/TLTpulse-degerlendirme).
# EVAL_GITHUB_TOKEN: sadece o repoda Actions (read/write) + Contents (read/write) izni olan fine-grained token.
# EVAL_SECRET: o reponun Actions secret'ı ile aynı, en az 32 karakter (sonuç HMAC imzası).
EVAL_REPO=
EVAL_GITHUB_TOKEN=
EVAL_SECRET=

# Certifier (isteğe bağlı): panelden API anahtarı ve sertifika tasarımının grup kimliği. Yoksa sertifikalar "Beklemede" kalır.
CERTIFIER_API_KEY=
CERTIFIER_GROUP_ID=
